# Copy to .env.local (never committed) and fill in.
# On Cloudflare the same names are set as Worker secrets:
#   npx wrangler secret put GEMINI_API_KEY

# Google AI Studio › Get API key
GEMINI_API_KEY=

# Optional. Default gemini-3.5-flash-lite
GEMINI_MODEL=

# Phase 1 (Supabase › Project Settings › API Keys)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
