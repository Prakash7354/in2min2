// Cloudflare Worker that runs the In2Min2 Next.js app, built by OpenNext
// (@opennextjs/cloudflare). `npm run deploy` builds and deploys from this Mac;
// Cloudflare's Git integration does the same on every push to main.
//
// "name" MUST match the Worker's name in the Cloudflare dashboard, or the
// Git build fails. The preview address is https://in2min2.<account>.workers.dev
//
// Public values only. Secrets (GEMINI_API_KEY, SUPABASE_SECRET_KEY,
// ALERT_EMAIL, later Stripe keys) are set with `npx wrangler secret put NAME` or in the
// dashboard as type "Secret". Never put them in this file.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "in2min2",
	// worker/main.js wraps the app OpenNext builds (.open-next/worker.js) and
	// adds the hourly safety job: database check, error emails, nightly backup.
	"main": "worker/main.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// The free preview address (in2min2.pksgrg.workers.dev) and a separate
	// preview address for every branch. Keep both until in2min2.com is live.
	"workers_dev": true,
	"preview_urls": true,
	// The real address (bought 14 Nov 2026 at Cloudflare). Cloudflare makes the
	// DNS records and the security certificate for each one on deploy.
	"routes": [
		{
			"pattern": "in2min2.com",
			"custom_domain": true
		},
		{
			"pattern": "www.in2min2.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Guests' photos (0006, lib/photo-store.ts): Cloudflare R2, kept in the EU
	// (bucket created by the owner, 14 Nov 2026). The binding name PHOTOS is
	// what the code uses; "jurisdiction" must stay "eu" or Cloudflare looks for
	// a different bucket. Local `npm run dev` uses a local stand-in, never the
	// real photos.
	"r2_buckets": [
		{ "binding": "PHOTOS", "bucket_name": "in2min2-photos", "jurisdiction": "eu" },
		// Nightly database copies and error notes (worker/main.js, lib/ops.ts).
		// Private: nothing serves it to the web. Created 19 Nov 2026, EU.
		{ "binding": "BACKUPS", "bucket_name": "in2min2-backups", "jurisdiction": "eu" }
	],
	// Alert emails to the owner, through Cloudflare Email Routing (free). The
	// address is the Worker secret ALERT_EMAIL, never written here.
	"send_email": [
		{ "name": "ALERTS" }
	],
	// The safety job runs at 7 minutes past every hour (worker/main.js).
	"triggers": {
		"crons": ["7 * * * *"]
	},
	"services": [
		// Lets the app call itself (used by OpenNext for caching). Must match "name".
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "in2min2"
		}
	],
	"vars": {
		"GEMINI_MODEL": "gemini-3.5-flash-lite"
	},
	"observability": {
		"enabled": true
	}
}