  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.161.0"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
